# --- Required ---------------------------------------------------------------
# Signs session tokens. Any long random string; the server refuses to start
# handling logins without it.
JWT_SECRET=
# First-login credentials for the single user. The values below are the ones
# every copy of this file ships with: in production the server refuses them
# unless ALLOW_DEFAULT_CREDENTIALS=true. Username 3-30 chars, password 8+.
DEFAULT_USERNAME=admin
DEFAULT_PASSWORD=smartchat
# Where the browser reaches this app.
NEXT_PUBLIC_API_URL=http://localhost:3000

# --- Providers: configure the ones you use; a model whose provider is missing
# --- returns 503 instead of preventing the app from starting.
OPENAI_API_KEY=
GEMINI_API_KEY=
CLAUDE_API_KEY=
GROQ_API_KEY=

# --- Retrieval (RAG): uploads and namespaces need all three; otherwise the
# --- upload route is disabled and the chat runs without retrieval.
PINECONE_API_KEY=
PINECONE_INDEX_NAME=

# --- Self-hosted models (the companion FastAPI server) --------------------
NEXT_PUBLIC_SERVER_URL=
NEXT_PUBLIC_SERVER_GPU_URL=
NEXT_PUBLIC_SERVER_SECRET_KEY=

# --- Storage -----------------------------------------------------------------
DATABASE_PATH=database.sqlite

# --- Optional tools, off by default ------------------------------------------
# Captures this machine's desktop into the chat. Only on a personal machine.
ENABLE_SCREENSHOT_TOOL=false
# Starts/stops an EC2 instance and runs `systemctl` over SSH. Needs the AWS
# variables and the key path below; the key path is never taken from a request.
ENABLE_REMOTE_SERVER_TOOLS=false
REMOTE_SERVER_PEM_PATH=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=

# Believe X-Forwarded-For for rate limiting. Only behind a proxy you control.
TRUST_PROXY=false
